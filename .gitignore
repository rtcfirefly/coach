# macOS
.DS_Store
._*

# Editor / OS cruft
*.swp
*~
.idea/
.vscode/

# Never commit credentials — the app is BYOK and keys live in the browser's
# localStorage, so nothing key-shaped belongs in this tree.
*.pem
*.key
.env
.env.*

# Claude Code local session settings (personal, not shared)
.claude/settings.local.json

# Local review notes and screenshots — kept on disk, not published
reviews/

# Vendored third-party code. Readable ES source IS committed — it can be
# reviewed, and reviewing it is the point of vendoring. Only the opaque
# artifacts are excluded: minified bundles and prebuilt .wasm, which cannot be
# audited and which trip GitHub secret scanning on an embedded gist URL.
# Their pins live in lab/vendor/vendor.hash; lab/fetch-vendor.sh restores them.
# transformers.web.min.js is the only file that must stay out: GitHub secret
# scanning rejects it over a gist URL embedded in a Whisper warning string.
# The ORT loaders are small, contain no secret-shaped tokens, and the page
# imports them same-origin — excluding them just 404s the neural voice.
lab/vendor/transformers.web.min.js
lab/vendor/*.wasm
